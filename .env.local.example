# EmailJS credentials for the contact form (FinalCta section).
# Copy to .env.local and fill in from https://dashboard.emailjs.com
# All three are public-safe (client-side) keys.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Supabase (blog + admin panel). From your project's Settings → API.
# Both are public-safe; writes are protected by RLS + Supabase Auth.
# Setup: run supabase/schema.sql in the SQL Editor, create the public
# `blog-images` bucket, disable sign-ups, and add the admin user manually.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Zeptaz Voice demo ─────────────────────────────────────────────────
# Public Zeptaz voice API origin. The browser requests a short-lived,
# single-use session grant before opening the protected WebSocket returned by
# the backend. No provider key or permanent credential belongs in this file.
# Leave unset and the demo panel renders its "offline" state instead.
NEXT_PUBLIC_VOICE_API_URL=https://voice.zeptaz.com
